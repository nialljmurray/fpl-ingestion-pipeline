PROJECT_ID=your-gcp-project-id
REGION=europe-west1
INGESTION_URL=https://REGION-PROJECT_ID.cloudfunctions.net/fpl_ingestion
LOADING_URL=https://REGION-PROJECT_ID.cloudfunctions.net/fpl_loading
SCHEDULER_SA=your-service-account@your-gcp-project-id.iam.gserviceaccount.com

# dbt service account fields (from downloaded SA JSON key file)
# Used by `make create-dbt-secrets` and `make push-dbt-secrets`
DBT_SA_TYPE=service_account
DBT_SA_PROJECT_ID=your-gcp-project-id
DBT_SA_PRIVATE_KEY_ID=your-private-key-id
DBT_SA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
DBT_SA_CLIENT_EMAIL=your-sa@your-gcp-project-id.iam.gserviceaccount.com
DBT_SA_CLIENT_ID=your-client-id
DBT_SA_AUTH_URI=https://accounts.google.com/o/oauth2/auth
DBT_SA_TOKEN_URI=https://oauth2.googleapis.com/token
DBT_SA_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
DBT_SA_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your-sa%40your-gcp-project-id.iam.gserviceaccount.com
